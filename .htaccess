DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve the complete FoxFlix application on the main hostname while its
    # account, payment, and streaming workers remain isolated at the origin.
    <IfModule mod_proxy.c>
        RewriteCond %{HTTP_HOST} ^foxnetwork\.be$ [NC]
        RewriteRule ^foxflix/?$ https://foxflix.foxnetwork.be/ [P,L,NE]
        RewriteCond %{HTTP_HOST} ^foxnetwork\.be$ [NC]
        RewriteRule ^foxflix/(.*)$ https://foxflix.foxnetwork.be/$1 [P,L,NE]
    </IfModule>

    # Send visitors from the legacy hostname to the canonical main-site path.
    RewriteCond %{HTTP_HOST} ^foxflix\.foxnetwork\.be$ [NC]
    RewriteRule ^ https://foxnetwork.be/foxflix/ [R=301,L,NE]

    # Keep one protocol, hostname, and homepage URL in Google's index.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^foxnetwork\.be$ [NC]
    RewriteRule ^ https://foxnetwork.be%{REQUEST_URI} [R=301,L,NE]

    # Redirect only direct browser requests; DirectoryIndex may still serve index.html.
    RewriteCond %{THE_REQUEST} \s/+index\.(?:html|php)[?\s] [NC]
    RewriteRule ^index\.(?:html|php)$ https://foxnetwork.be/ [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+contact(?:\.php)?[?\s] [NC]
    RewriteRule ^contact(?:\.php)?$ https://foxnetwork.be/contact.html [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+privacy(?:\.php)?[?\s] [NC]
    RewriteRule ^privacy(?:\.php)?$ https://foxnetwork.be/privacy.html [R=301,L]

    # Public blog articles use clean, shareable URLs.
    # Specific blog routes must precede the flat post permalink rule.
    RewriteRule ^blog/rss\.xml$ blog/rss.php [L]
    RewriteRule ^blog/category/([a-z0-9-]+)/?$ blog/category.php?slug=$1 [L,QSA]
    RewriteRule ^blog/authors/?$ blog/author.php [L,QSA]
    RewriteRule ^blog/authors/([a-z0-9-]+)/?$ blog/author.php?slug=$1 [L,QSA]
    RewriteRule ^blog/([a-z0-9-]+)/?$ blog/post.php?slug=$1 [L,QSA]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "0"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:; style-src 'self' 'unsafe-inline' https: data:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https:; upgrade-insecure-requests"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # Account, checkout, admin, and API screens are functional pages, not search results.
    <FilesMatch "^(?:login|logout|register|verify-email|forgot-password|reset-password|two-factor|billing|invoice|order|orders|pay|payment-return|settings|server|store|support|setup|upgrades|cron|mollie-webhook|pterodactyl-webhook|email-track|email-click|return-admin)\.php$">
        Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    </FilesMatch>
    <IfModule mod_setenvif.c>
        SetEnvIf Request_URI "^/(?:admin|client|api)(?:/|$)" private_search_route
        Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=private_search_route
    </IfModule>
    <FilesMatch "\.(css|js|png|jpe?g|gif|svg|webp|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header always set Cache-Control "private, no-store, max-age=0"
        Header always set Pragma "no-cache"
    </FilesMatch>
</IfModule>
